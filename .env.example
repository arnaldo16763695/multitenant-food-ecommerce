# WhatsApp order notifications (Meta Cloud API, Model A: one platform-owned number for every
# tenant). Without PHONE_NUMBER_ID + ACCESS_TOKEN, WhatsApp sends degrade to a console log.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=es
